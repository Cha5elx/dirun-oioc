# 有赞配置
YOUZAN_CLIENT_ID=your_client_id
YOUZAN_CLIENT_SECRET=your_client_secret
YOUZAN_GRANT_ID=your_grant_id
YOUZAN_DRY_RUN=true
YOUZAN_SIGN_SECRET=your_youzan_sign_secret
# 本地调试：通过服务器代理调用有赞 API（仅本地后端设置，服务器留空）
# YOUZAN_PROXY_URL=http://服务器IP:3000/api/internal/youzan-proxy
# YOUZAN_PROXY_SECRET=与服务器一致的共享密钥

# 第三方一物一码配置
OIOC_BASE_URL=https://api.oioc-provider.com
OIOC_USERNAME=your_username
OIOC_PASSWORD=your_password
OIOC_SIGN_SECRET=your_oioc_sign_secret

# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 配置
JWT_SECRET=请设置一个至少32位的随机字符串
JWT_EXPIRES_IN=24h

# 安全配置
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_MAX=100
WEBHOOK_RATE_LIMIT_MAX=30
MAX_REQUEST_BODY_SIZE=1mb
