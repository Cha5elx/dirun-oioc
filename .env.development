# 本地测试环境配置

# 有赞配置 - 使用Dry Run模式，不真实调用有赞API
YOUZAN_CLIENT_ID=test_client_id
YOUZAN_CLIENT_SECRET=test_client_secret
YOUZAN_GRANT_ID=test_grant_id
YOUZAN_DRY_RUN=true

# 第三方一物一码配置 - 使用模拟数据
OIOC_BASE_URL=http://localhost:3000/mock/oioc
OIOC_USERNAME=test_user
OIOC_PASSWORD=test_password

# 服务器配置
PORT=3000
NODE_ENV=development
